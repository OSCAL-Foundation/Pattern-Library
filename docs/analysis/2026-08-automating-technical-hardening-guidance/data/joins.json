{
  "note": "The six questions are answered one at a time, which hides the thing that decides whether the set works: what joins one answer to the next. This is the chain from the moment the rule is introduced to the moment something records that it was met, with every foreign key and the primary key it resolves to. Every literal is one of the two running rules as the six questions page encodes it, so the three chains can be read against each other; tools/verify.py fails the build if a value here is not in that encoding.",
  "title": "What joins one answer to the next",
  "intro": "The chain starts where the rule is introduced and runs to the claim and the result. What a step costs is how many relationships it is made of and how each one resolves.",
  "stages": [
    {
      "key": "rule",
      "label": "Rule",
      "slot": "1",
      "meaning": "where the rule is introduced"
    },
    {
      "key": "control",
      "label": "Control",
      "slot": "2",
      "meaning": "the regulation it serves"
    },
    {
      "key": "check",
      "label": "Check",
      "slot": "3",
      "meaning": "how it is tested"
    },
    {
      "key": "runtime",
      "label": "Runtime",
      "slot": "5",
      "meaning": "what executes the check"
    },
    {
      "key": "claim",
      "label": "Claim",
      "slot": "6a",
      "meaning": "the system's statement that it holds"
    },
    {
      "key": "result",
      "label": "Result",
      "slot": "6b",
      "meaning": "what an assessment recorded"
    }
  ],
  "step_order": [
    [
      "rule",
      "check"
    ],
    [
      "rule",
      "control"
    ],
    [
      "check",
      "runtime"
    ],
    [
      "runtime",
      "claim"
    ],
    [
      "runtime",
      "result"
    ],
    [
      "claim",
      "result"
    ],
    [
      "result",
      "control"
    ]
  ],
  "how": [
    {
      "key": "containment",
      "label": "Containment",
      "meaning": "One is inside the other, so there is no key to match and nothing to dereference."
    },
    {
      "key": "reference",
      "label": "Reference",
      "meaning": "A field holds an identifier the schema knows is an identifier, and it resolves."
    },
    {
      "key": "name-match",
      "label": "Name match",
      "meaning": "Two strings are equal by convention. It holds where the two agree and breaks silently where they do not, and no schema can check it."
    },
    {
      "key": "composite",
      "label": "Composite key",
      "meaning": "Two fields have to match together. Either one alone resolves to the wrong thing or to nothing."
    },
    {
      "key": "none",
      "label": "No join",
      "meaning": "There is no field on either side. The relation has to be recovered by walking through something else, or it is simply not there."
    }
  ],

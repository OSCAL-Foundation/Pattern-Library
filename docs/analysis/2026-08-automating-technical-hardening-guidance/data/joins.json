{
  "note": "The join chain connects rule definitions, checks, implementation claims and assessment results. Each relationship identifies a foreign key and the corresponding primary key. Values match the two example rules on the six questions page; tools/verify.py checks each value against those encodings.",
  "title": "How the answers connect",
  "intro": "The chain connects a rule to checks, implementation claims and assessment results. Each step identifies the relationships a consumer must resolve and the fields used to resolve those relationships.",
  "stages": [
    {
      "key": "rule",
      "label": "Rule",
      "slot": "1",
      "meaning": "where the rule is introduced"
    },
    {
      "key": "control",
      "label": "Control",
      "slot": "2",
      "meaning": "the framework control served by the rule"
    },
    {
      "key": "check",
      "label": "Check",
      "slot": "3",
      "meaning": "the test of the rule"
    },
    {
      "key": "runtime",
      "label": "Runtime",
      "slot": "5",
      "meaning": "what executes the check"
    },
    {
      "key": "claim",
      "label": "Claim",
      "slot": "6a",
      "meaning": "the system owner's statement of implementation"
    },
    {
      "key": "result",
      "label": "Result",
      "slot": "6b",
      "meaning": "what an assessment recorded"
    }
  ],
  "step_order": [
    [
      "rule",
      "check"
    ],
    [
      "rule",
      "control"
    ],
    [
      "check",
      "runtime"
    ],
    [
      "runtime",
      "claim"
    ],
    [
      "runtime",
      "result"
    ],
    [
      "claim",
      "result"
    ],
    [
      "result",
      "control"
    ]
  ],
  "how": [
    {
      "key": "containment",
      "label": "Containment",
      "meaning": "A parent contains the child directly; no key matching or dereferencing is needed."
    },
    {
      "key": "reference",
      "label": "Reference",
      "meaning": "A schema-defined identifier reference resolves to a target identifier."
    },
    {
      "key": "name-match",
      "label": "Name match",
      "meaning": "Two strings match by convention. The schema does not enforce the relationship, so a mismatch may go undetected."
    },
    {
      "key": "composite",
      "label": "Composite key",
      "meaning": "Two fields jointly identify a target. Either field alone may identify the wrong target or no target."
    },
    {
      "key": "none",
      "label": "No join",
      "meaning": "No field directly connects the entries. A consumer must follow other relationships, or the connection is absent."
    }
  ],
  "approaches": {

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "site: serve",
      "detail": "docs/ with summit/ overlaid at /patterns/summit/, the way Pages serves it",
      "type": "shell",
      "command": "python3 tools/serve.py --port 8100 --exact-port --no-open",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "site-serve",
        "fileLocation": ["relative", "${workspaceFolder}"],
        // A server produces no diagnostics, but a background task needs a
        // pattern for VS Code to accept the matcher at all, and without an
        // accepted matcher every launch stops to ask whether to continue.
        // This one is deliberately unmatchable; beginsPattern and endsPattern
        // are what actually do the work.
        "pattern": {
          "regexp": "^$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Serving ",
          "endsPattern": "Ctrl-C to stop"
        }
      }
    },
    {
      "label": "site: stop",
      "detail": "Terminates the serve task, so the next launch gets port 8000 back.",
      "type": "shell",
      "command": "echo ${input:terminateServe}",
      "presentation": { "reveal": "never", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "site: assemble _site",
      "detail": "The exact tree the deploy workflow uploads. Use to check the real artifact.",
      "type": "shell",
      "command": "rm -rf _site && mkdir -p _site/patterns && cp -r docs/. _site/ && cp -r summit _site/patterns/summit && echo \"assembled $(du -sh _site | cut -f1) at _site/\"",      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "analysis 2026-08: verify",
      "detail": "The analysis harness. Needs TFG_CORPORA pointing at the corpora checkout.",
      "type": "shell",
      "command": "python3 tools/verify.py --all",
      "options": {
        "cwd": "${workspaceFolder}/docs/analysis/2026-08-automating-technical-hardening-guidance",
        "env": { "TFG_CORPORA": "${input:corporaPath}" }
      },
      "problemMatcher": {
        "owner": "verify",
        "fileLocation": "autoDetect",
        "pattern": [
          {
            "regexp": "^\\s+FAIL\\s+(.*)$",
            "severity": 1,
            "message": 1
          }
        ]
      }
    },
    {
      "label": "analysis 2026-08: regenerate",
      "detail": "Run every generator. A generated file that differs afterwards was hand-edited.",
      "type": "shell",
      "command": "for g in extract pattern_examples oscal_artifacts sources_files diagrams approach_pages scenario_page bundle; do echo \"-- $g\"; python3 tools/$g.py || exit 1; done",
      "options": {
        "cwd": "${workspaceFolder}/docs/analysis/2026-08-automating-technical-hardening-guidance",
        "env": { "TFG_CORPORA": "${input:corporaPath}" }
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "corporaPath",
      "type": "promptString",
      "description": "Path to the tfg-automated-assessments corpora checkout",
      "default": "${env:HOME}/pagesource/tfg-automated-assessments"
    },
    {
      "id": "terminateServe",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "site: serve"
    }
  ]
}
